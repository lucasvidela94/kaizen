{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["dist", ".astro"],
  "rules": {
    "import/no-unassigned-import": "off"
  }
}
