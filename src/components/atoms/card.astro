---
interface Props {
  highlight?: boolean;
  interactive?: boolean;
  class?: string;
}

const { highlight = false, interactive = true, class: className } = Astro.props;
---

<div
  class:list={[
    "rounded-lg border border-portfolio-border bg-portfolio-card p-6",
    interactive && "transition-all duration-300 hover:border-portfolio-accent/50",
    highlight ? "shadow-glow" : interactive && "hover:shadow-card",
    className,
  ]}
>
  <slot />
</div>
