---
interface Props {
  highlight?: boolean;
  interactive?: boolean;
  class?: string;
}

const { highlight = false, interactive = true, class: className } = Astro.props;
---

<div
  class:list={[
    "rounded-sm border border-portfolio-border bg-portfolio-card/60 p-6",
    interactive && "transition-colors duration-300 hover:border-portfolio-accent/60",
    highlight && "border-l-2 border-l-portfolio-mark",
    className,
  ]}
>
  <slot />
</div>
