---
interface Props {
  title: string;
  description?: string;
  level?: "h1" | "h2";
}

const { title, description, level: Heading = "h2" } = Astro.props;
---

<div>
  <Heading class="text-3xl">{title}</Heading>
  {description && <p class="mt-4 text-sm leading-relaxed text-portfolio-muted">{description}</p>}
</div>
