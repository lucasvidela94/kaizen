---
interface Props {
  variant?: "accent" | "outline";
  class?: string;
}

const { variant = "accent", class: className } = Astro.props;

const variants = {
  accent: "border border-portfolio-accent/20 bg-portfolio-accent/10 text-portfolio-accent",
  outline: "border border-portfolio-border text-portfolio-secondary",
};
---

<span class:list={["inline-flex items-center rounded-full px-3 py-1 text-sm", variants[variant], className]}>
  <slot />
</span>
