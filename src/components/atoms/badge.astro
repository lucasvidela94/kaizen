---
interface Props {
  variant?: "accent" | "outline";
  class?: string;
}

const { variant = "accent", class: className } = Astro.props;

const variants = {
  accent: "border border-portfolio-accent/30 text-portfolio-accent",
  outline: "border border-portfolio-border text-portfolio-secondary",
};
---

<span class:list={["inline-flex items-center rounded-sm px-2.5 py-0.5 text-sm", variants[variant], className]}>
  <slot />
</span>
