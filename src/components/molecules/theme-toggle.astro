<button
  type="button"
  data-theme-toggle
  aria-label="Toggle color theme"
  class="flex h-11 items-center px-2 text-portfolio-muted uppercase transition-colors hover:text-portfolio-primary"
>
  <span class="hidden dark:inline">Light</span>
  <span class="dark:hidden">Dark</span>
</button>

<script>
  import { toggleTheme } from "../../scripts/theme";

  document.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("[data-theme-toggle]")) toggleTheme();
  });
</script>
