---
import ExternalLink from "../atoms/external-link.astro";
import { GITHUB_HANDLE, GITHUB_URL, SITE_EMAIL } from "../../data/site";

interface Props {
  separator?: string;
}

const { separator } = Astro.props;
---

<div class="flex flex-col items-center justify-center gap-2 text-portfolio-accent sm:flex-row sm:gap-4">
  <ExternalLink href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</ExternalLink>
  {separator && <span class="hidden sm:inline">{separator}</span>}
  <ExternalLink href={GITHUB_URL}>GitHub @{GITHUB_HANDLE}</ExternalLink>
</div>
