---
import { Image } from "astro:assets";
import Card from "../atoms/card.astro";
import Badge from "../atoms/badge.astro";
import ExternalLink from "../atoms/external-link.astro";

interface Props {
  name: string;
  href: string;
  hostname: string;
  description: string;
  tags: readonly string[];
  logo: ImageMetadata;
}

const { name, href, hostname, description, tags, logo } = Astro.props;
---

<Card interactive={false} class="p-8">
  <div class="flex items-start gap-6">
    <Image src={logo} alt={`${name} logo`} width={64} height={64} class="size-16 shrink-0 rounded-lg object-contain" />
    <div class="flex-1">
      <div class="mb-2 flex items-center gap-3">
        <h3 class="text-xl font-semibold text-portfolio-primary">{name}</h3>
        <ExternalLink href={href} class="text-sm text-portfolio-accent">{hostname}</ExternalLink>
      </div>
      <p class="mb-4 leading-relaxed text-portfolio-secondary">{description}</p>
      <ul class="flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <li>
              <Badge>{tag}</Badge>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Card>
