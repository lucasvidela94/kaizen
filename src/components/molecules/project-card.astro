---
import type { Project } from "../../data/projects";

type Props = Project;

const { title, description, tech, href, highlight = false } = Astro.props;
---

<article class="grid gap-3 border-t border-portfolio-border py-8 md:grid-cols-[1fr_1.6fr] md:gap-10">
  <h3 class="flex items-baseline gap-3 text-lg">
    {highlight && <span class="size-2 shrink-0 bg-portfolio-mark" aria-hidden="true"></span>}
    {
      href ? (
        <a href={href} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-portfolio-accent">
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>
  <div>
    <p class="leading-relaxed text-portfolio-secondary">{description}</p>
    <p class="mt-3 text-sm text-portfolio-muted">{tech}</p>
  </div>
</article>
