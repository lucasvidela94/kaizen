---
import type { Project } from "../../data/projects";

type Props = Project;

const { title, description, tech, href, highlight = false } = Astro.props;
const Tag = href ? "a" : "div";
const linkProps = href ? { href, target: "_blank", rel: "noopener noreferrer" } : {};
---

<Tag
  {...linkProps}
  class:list={["grid gap-4 border-b border-portfolio-border py-6 md:grid-cols-[1.3fr_1fr] md:gap-12", href && "row-link"]}
>
  <h3 class="text-[clamp(2rem,4.4vw,4rem)]">
    {highlight && <span class="mr-3 align-middle text-[0.35em]" aria-hidden="true">●</span>}{title}{href && <span class="sr-only"> (opens in a new tab)</span>}
  </h3>
  <div class="text-xs">
    <p class="text-sm leading-relaxed text-portfolio-secondary">{description}</p>
    <p class="mt-3 tracking-wider text-portfolio-muted uppercase">{tech}</p>
  </div>
</Tag>
