---
import type { SkillGroup } from "../../data/skills";

type Props = SkillGroup;

const { title, items } = Astro.props;
---

<div class="border-t border-portfolio-border py-6">
  <h3 class="mb-3 text-base">{title}</h3>
  <ul class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-portfolio-secondary">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>
