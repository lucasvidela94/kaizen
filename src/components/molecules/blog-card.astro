---
import PostMeta from "./post-meta.astro";
import TagList from "./tag-list.astro";
import type { Post } from "../../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, excerpt, publishedAt, readTime, category, tags } = post.data;
---

<article
  data-blog-card
  data-category={category.toLowerCase().replace(/\s+/g, "-")}
  data-tags={tags.join(",")}
  data-search={[title, excerpt, category, ...tags].join(" ").toLowerCase()}
>
  <a
    href={`/blog/${post.id}`}
    class="row-link grid gap-3 border-b border-portfolio-border py-6 md:grid-cols-[13rem_1fr_16rem] md:gap-8"
  >
    <PostMeta date={publishedAt} {readTime} {category} />
    <div>
      <h3 class="text-[clamp(1.7rem,3.2vw,2.9rem)] uppercase">{title}</h3>
      <p class="mt-3 max-w-xl text-xs leading-relaxed text-portfolio-secondary">{excerpt}</p>
    </div>
    <TagList tags={tags} limit={3} />
  </a>
</article>
