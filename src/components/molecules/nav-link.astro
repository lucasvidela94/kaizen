---
interface Props {
  href: string;
  label: string;
  current: boolean;
}

const { href, label, current } = Astro.props;
---

<a
  href={href}
  aria-current={current ? "page" : undefined}
  class:list={[
    "transition-colors",
    current
      ? "text-portfolio-primary underline decoration-1 underline-offset-4"
      : "text-portfolio-muted hover:text-portfolio-primary",
  ]}
>
  {label}
</a>
