---
import { Image } from "astro:assets";
import ExternalLink from "../atoms/external-link.astro";
import Chip from "../atoms/chip.astro";

interface Props {
  heading: string;
  name: string;
  href: string;
  hostname: string;
  description: string;
  tags: readonly string[];
  logo: ImageMetadata;
}

const { heading, name, href, hostname, description, tags, logo } = Astro.props;
---

<div class="grid gap-4 border-b border-portfolio-border py-6 md:grid-cols-[1fr_2fr] md:gap-12">
  <p class="text-xs tracking-wider text-portfolio-muted uppercase">{heading}</p>
  <div class="flex items-start gap-5">
    <Image src={logo} alt={`${name} logo`} width={48} height={48} class="size-12 shrink-0 bg-[#e8e8e3] object-contain p-1" />
    <div>
      <h3 class="text-3xl">{name}</h3>
      <ExternalLink href={hostname.startsWith("http") ? hostname : href} class="text-xs text-portfolio-muted underline underline-offset-4">{hostname}</ExternalLink>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-portfolio-secondary">{description}</p>
      <ul class="mt-3 flex flex-wrap gap-1.5">{tags.map((tag) => <li><Chip>{tag}</Chip></li>)}</ul>
    </div>
  </div>
</div>
