---
import Chip from "../atoms/chip.astro";

interface Props {
  tags: string[];
  limit?: number;
}

const { tags, limit = tags.length } = Astro.props;
const hidden = tags.length - limit;
---

<ul class="flex flex-wrap gap-1.5">
  {tags.slice(0, limit).map((tag) => <li><Chip>{tag}</Chip></li>)}
  {hidden > 0 && <li><Chip>+{hidden}</Chip></li>}
</ul>
