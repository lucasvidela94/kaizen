---
import Badge from "../atoms/badge.astro";

interface Props {
  tags: string[];
  limit?: number;
}

const { tags, limit = tags.length } = Astro.props;
const hidden = tags.length - limit;
---

<ul class="flex flex-wrap gap-2">
  {
    tags.slice(0, limit).map((tag) => (
      <li>
        <Badge variant="outline" class="px-2 py-0.5 text-xs">
          {tag}
        </Badge>
      </li>
    ))
  }
  {
    hidden > 0 && (
      <li>
        <Badge variant="outline" class="px-2 py-0.5 text-xs">
          +{hidden}
        </Badge>
      </li>
    )
  }
</ul>
