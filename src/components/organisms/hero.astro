---
import { SITE_EMAIL } from "../../data/site";

const action = "underline decoration-1 underline-offset-8 transition-opacity hover:opacity-60";
---

<section class="relative flex min-h-[calc(100svh-5.5rem)] flex-col overflow-hidden px-3 pt-6 pb-8">
  <div
    class="halftone animate-rise pointer-events-none absolute inset-y-0 right-0 w-full md:w-[62%]"
    aria-hidden="true"
  >
  </div>
  <div class="relative z-10 flex flex-1 flex-col justify-between gap-16">
    <h1 class="animate-settle max-w-[14ch] text-[clamp(3.4rem,10.5vw,10.5rem)] leading-[0.88] tracking-[-0.02em]">
      Lucas Videla builds software that stays working.
    </h1>
    <div class="animate-settle flex flex-col gap-6 [animation-delay:200ms] sm:flex-row sm:items-end sm:justify-between">
      <p class="max-w-sm leading-relaxed text-portfolio-secondary">
        Full-stack engineer at Magma Labs. Elixir, TypeScript and Go, from Patagonia.
      </p>
      <p class="flex items-center gap-8 text-base">
        <a href="#work" class={action}>See my work</a>
        <a href={`mailto:${SITE_EMAIL}`} class={action}>Get in touch</a>
      </p>
    </div>
  </div>
</section>
