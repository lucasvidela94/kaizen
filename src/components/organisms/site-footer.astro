---
import ExternalLink from "../atoms/external-link.astro";
import { GITHUB_URL, SITE_EMAIL } from "../../data/site";
import { getPublishedPosts } from "../../lib/posts";

const [latest] = await getPublishedPosts();
---

<footer class="fixed inset-x-0 bottom-0 z-50 border-t border-portfolio-border bg-portfolio-bg">
  <div class="flex h-11 items-center justify-between gap-6 px-3 text-xs tracking-wider uppercase">
    <p class="flex gap-2 whitespace-nowrap">
      <span>Socials //</span>
      <ExternalLink href={GITHUB_URL} class="text-portfolio-muted">GitHub</ExternalLink>
      <span class="text-portfolio-muted">//</span>
      <ExternalLink href={`mailto:${SITE_EMAIL}`} class="text-portfolio-muted">Email</ExternalLink>
    </p>
    <p class="hidden items-center gap-2 text-portfolio-muted md:flex">
      <span class="size-1.5 rounded-full bg-portfolio-primary" aria-hidden="true"></span>
      Available for contract work
    </p>
    {
      latest && (
        <p class="hidden max-w-[34ch] gap-2 truncate whitespace-nowrap sm:flex">
          <span>Latest //</span>
          <a href={`/blog/${latest.id}`} class="truncate text-portfolio-muted transition-colors hover:text-portfolio-primary">
            {latest.data.title}
          </a>
        </p>
      )
    }
  </div>
</footer>
