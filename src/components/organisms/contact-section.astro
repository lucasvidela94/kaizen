---
import PageSection from "../atoms/page-section.astro";
import SectionLabel from "../atoms/section-label.astro";
import ContactLinks from "../molecules/contact-links.astro";
import { SITE_EMAIL } from "../../data/site";

interface Props {
  title?: string;
  text?: string;
}

const {
  title = "Available for contract work and consulting.",
  text = "If you need someone who can take ownership and ship, reach out.",
} = Astro.props;
---

<PageSection class="mb-24">
  <SectionLabel label="Contact" />
  <p class="max-w-5xl py-8 font-display text-[clamp(2.2rem,6vw,6rem)] leading-[0.92]">{title}</p>
  <a
    href={`mailto:${SITE_EMAIL}`}
    class="font-display text-[clamp(1.5rem,4vw,3.5rem)] underline decoration-1 underline-offset-8 transition-opacity hover:opacity-60"
  >
    {SITE_EMAIL}
  </a>
  <p class="mt-6 max-w-md text-sm leading-relaxed text-portfolio-secondary">{text}</p>
  <ContactLinks />
</PageSection>
