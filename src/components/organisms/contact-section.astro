---
import PageSection from "../atoms/page-section.astro";
import ContactLinks from "../molecules/contact-links.astro";

interface Props {
  title?: string;
  text?: string;
  separator?: string;
}

const {
  title = "Available for contract work and consulting.",
  text = "If you need someone who can take ownership and ship, reach out.",
  separator,
} = Astro.props;
---

<PageSection>
  <div class="border-t border-portfolio-border pt-12">
    <h2 class="mb-4 max-w-2xl text-3xl">{title}</h2>
    <p class="mb-8 max-w-xl text-lg text-portfolio-secondary">{text}</p>
    <ContactLinks {separator} />
  </div>
</PageSection>
