---
import PageSection from "../atoms/page-section.astro";
import SectionLabel from "../atoms/section-label.astro";
import ProjectCard from "../molecules/project-card.astro";
import type { Project } from "../../data/projects";

interface Props {
  title: string;
  description?: string;
  projects: Project[];
  id?: string;
}

const { title, description, projects, id } = Astro.props;
---

<PageSection class="mb-24" id={id}>
  <SectionLabel label={title} count={projects.length} />
  {description && <p class="max-w-xl py-4 text-xs leading-relaxed text-portfolio-secondary">{description}</p>}
  <ul>
    {projects.map((project) => <li><ProjectCard {...project} /></li>)}
  </ul>
</PageSection>
