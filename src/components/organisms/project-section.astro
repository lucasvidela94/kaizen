---
import PageSection from "../atoms/page-section.astro";
import SectionTitle from "../atoms/section-title.astro";
import ProjectCard from "../molecules/project-card.astro";
import type { Project } from "../../data/projects";

interface Props {
  title: string;
  description?: string;
  projects: Project[];
}

const { title, description, projects } = Astro.props;
---

<PageSection>
  <div class="grid gap-8 md:grid-cols-[13rem_1fr] md:gap-12">
    <div class="md:sticky md:top-8 md:self-start">
      <SectionTitle title={title} description={description} />
    </div>
    <ul class="border-b border-portfolio-border">
      {
        projects.map((project) => (
          <li>
            <ProjectCard {...project} />
          </li>
        ))
      }
    </ul>
  </div>
</PageSection>
