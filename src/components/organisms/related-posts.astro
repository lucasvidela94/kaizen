---
import Card from "../atoms/card.astro";
import PostMeta from "../molecules/post-meta.astro";
import type { Post } from "../../lib/posts";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <Card interactive={false} class="p-8">
      <h2 class="mb-6 text-2xl font-bold text-portfolio-primary">Related Posts</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {posts.map(({ id, data }) => (
          <a href={`/blog/${id}`} class="block rounded-lg border border-portfolio-border p-6 transition-colors hover:border-portfolio-accent/50">
            <h3 class="mb-2 text-lg font-semibold text-portfolio-primary">{data.title}</h3>
            <p class="mb-3 line-clamp-2 text-sm text-portfolio-secondary">{data.excerpt}</p>
            <PostMeta date={data.publishedAt} readTime={data.readTime} category={data.category} />
          </a>
        ))}
      </div>
    </Card>
  )
}
