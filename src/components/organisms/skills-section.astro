---
import SkillGroup from "../molecules/skill-group.astro";
import { skillGroups } from "../../data/skills";
---

<section class="px-6 py-20">
  <div class="mx-auto max-w-4xl">
    <h2 class="mb-12 text-center text-3xl font-bold text-portfolio-primary">Skills & Technologies</h2>
    <div class="space-y-12">
      {skillGroups.map((group) => <SkillGroup {...group} />)}
    </div>
  </div>
</section>
