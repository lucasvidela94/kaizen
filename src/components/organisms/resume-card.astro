---
import Card from "../atoms/card.astro";
import Icon from "../atoms/icon.astro";
---

<Card interactive={false} class="mt-16 p-8">
  <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
    <div>
      <h2 class="mb-2 text-2xl font-bold text-portfolio-primary">Resume</h2>
      <p class="text-portfolio-secondary">Download my CV for more details on experience and skills.</p>
    </div>
    <a
      href="/cv_lucasvidela.pdf"
      download
      class="inline-flex items-center gap-2 rounded-lg border border-portfolio-accent/20 bg-portfolio-accent/10 px-6 py-3 font-mono text-sm text-portfolio-accent transition-all duration-300 hover:border-portfolio-accent/40 hover:bg-portfolio-accent/20"
    >
      <Icon name="download" /> Download CV
    </a>
  </div>
</Card>
