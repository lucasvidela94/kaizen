---
import NavLink from "../molecules/nav-link.astro";
import ThemeToggle from "../molecules/theme-toggle.astro";
import { navItems } from "../../data/nav";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));
---

<header class="absolute inset-x-0 top-0 z-50 px-6 py-6">
  <div class="mx-auto flex max-w-5xl items-center justify-between">
    <a href="/" class="font-display text-lg font-bold" aria-label="Lucas Videla, home">
      <span class="sm:hidden">LV</span>
      <span class="hidden sm:inline">Lucas Videla</span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-1 sm:gap-4">
      {navItems.map((item) => <NavLink {...item} current={isCurrent(item.href)} />)}
      <ThemeToggle />
    </nav>
  </div>
</header>
