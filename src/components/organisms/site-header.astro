---
import LocalTime from "../molecules/local-time.astro";
import NavLink from "../molecules/nav-link.astro";
import ThemeToggle from "../molecules/theme-toggle.astro";
import { navItems } from "../../data/nav";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));
---

<header class="chrome-bar fixed inset-x-0 top-0 z-50 border-b border-portfolio-border bg-portfolio-bg">
  <div class="flex h-11 items-center justify-between px-3 text-xs tracking-wider uppercase">
    <a href="/" class="flex h-11 items-center gap-3" aria-label="Lucas Videla, home">
      <span class="font-medium">Lucas Videla</span>
      <span class="hidden items-center gap-3 text-portfolio-muted md:flex">
        <span aria-hidden="true">/</span>
        Patagonia, Argentina
        <LocalTime />
      </span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-1 sm:gap-2">
      {navItems.map((item) => <NavLink {...item} current={isCurrent(item.href)} />)}
      <ThemeToggle />
    </nav>
  </div>
</header>
