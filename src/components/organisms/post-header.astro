---
import PostMeta from "../molecules/post-meta.astro";
import TagList from "../molecules/tag-list.astro";
import type { Post } from "../../lib/posts";

interface Props {
  post: Post;
}

const { title, description, author, publishedAt, readTime, category, tags } = Astro.props.post.data;
---

<header class="mb-8 border-b border-portfolio-border pb-8">
  <h1 class="mb-4 text-4xl font-bold text-portfolio-primary">{title}</h1>
  <p class="mb-6 text-xl text-portfolio-secondary">{description}</p>
  <PostMeta {author} date={publishedAt} {readTime} {category} />
  {tags.length > 0 && <div class="mt-4"><TagList {tags} /></div>}
</header>
