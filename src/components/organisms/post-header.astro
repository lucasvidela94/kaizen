---
import PostMeta from "../molecules/post-meta.astro";
import TagList from "../molecules/tag-list.astro";
import type { Post } from "../../lib/posts";

interface Props {
  post: Post;
}

const { title, description, publishedAt, readTime, category, tags } = Astro.props.post.data;
---

<header class="border-b border-portfolio-border pb-10">
  <h1 class="text-[clamp(2.6rem,7.5vw,7.5rem)] leading-[0.88] uppercase">{title}</h1>
  <p class="mt-8 max-w-xl text-xs leading-relaxed text-portfolio-secondary">{description}</p>
  <div class="mt-6 space-y-4">
    <PostMeta date={publishedAt} {readTime} {category} />
    {tags.length > 0 && <TagList {tags} />}
  </div>
</header>
