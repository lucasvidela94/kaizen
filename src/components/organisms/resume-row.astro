---
import PageSection from "../atoms/page-section.astro";
import SectionLabel from "../atoms/section-label.astro";
---

<PageSection class="mb-16">
  <SectionLabel label="Resume" />
  <a
    href="/cv_lucasvidela.pdf"
    download
    class="row-link flex items-baseline justify-between gap-6 border-b border-portfolio-border py-6"
  >
