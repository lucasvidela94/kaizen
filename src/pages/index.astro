---
import BaseLayout from "../layouts/base-layout.astro";
import ContactSection from "../components/organisms/contact-section.astro";
import Hero from "../components/organisms/hero.astro";
import ProjectSection from "../components/organisms/project-section.astro";
import ServicesSection from "../components/organisms/services-section.astro";
import SkillsSection from "../components/organisms/skills-section.astro";
import { openSource, products, professionalWork, selectedBuilds } from "../data/projects";
import { pageMeta } from "../data/site";
import { homeSchema } from "../lib/schema";
---

<BaseLayout {...pageMeta.home} schema={homeSchema}>
  <Hero />
  <ProjectSection id="work" title="Professional work" projects={professionalWork} />
  <ProjectSection title="Selected builds" projects={selectedBuilds} />
  <ProjectSection
    title="Products"
    description="Applications I designed and built end to end, from local-first desktop tools to blockchain systems."
    projects={products}
  />
  <ProjectSection
    title="Open source"
    description="Tools for working with AI agents, plus a few developer utilities. Everything is on GitHub."
    projects={openSource}
  />
  <SkillsSection />
  <ServicesSection />
  <ContactSection />
</BaseLayout>
