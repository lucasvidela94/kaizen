---
import BaseLayout from "../layouts/base-layout.astro";
import AboutIntro from "../components/organisms/about-intro.astro";
import CompaniesSection from "../components/organisms/companies-section.astro";
import ContactSection from "../components/organisms/contact-section.astro";
import ResumeRow from "../components/organisms/resume-row.astro";
import { pageMeta } from "../data/site";
import { aboutSchema } from "../lib/schema";
---

<BaseLayout {...pageMeta.about} schema={aboutSchema}>
  <AboutIntro />
  <CompaniesSection />
  <ResumeRow />
  <ContactSection title="Say hello." text="Reach out by email or find the code on GitHub." />
</BaseLayout>
