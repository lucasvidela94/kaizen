---
import BaseLayout from "../../layouts/base-layout.astro";
import PageSection from "../../components/atoms/page-section.astro";
import BlogFilters from "../../components/organisms/blog-filters.astro";
import BlogList from "../../components/organisms/blog-list.astro";
import SubscribeCard from "../../components/organisms/subscribe-card.astro";
import { getCategories, getPublishedPosts, getTags } from "../../lib/posts";
import { pageMeta } from "../../data/site";

const posts = await getPublishedPosts();
---

<BaseLayout {...pageMeta.blog}>
  <PageSection width="6xl" class="pt-32 pb-0">
    <div class="mb-12 text-center">
      <h1 class="mb-4 text-4xl font-bold text-portfolio-primary">Blog</h1>
      <p class="mx-auto max-w-2xl text-lg text-portfolio-secondary">{pageMeta.blog.description}</p>
    </div>
    <BlogFilters categories={getCategories(posts)} tags={getTags(posts)} />
    <BlogList {posts} />
  </PageSection>
  <SubscribeCard />
</BaseLayout>
