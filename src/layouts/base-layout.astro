---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import SeoHead from "../components/molecules/seo-head.astro";
import SiteFooter from "../components/organisms/site-footer.astro";
import SiteHeader from "../components/organisms/site-header.astro";
import { GITHUB_URL, SITE_NAME } from "../data/site";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  noindex?: boolean;
  schema?: object;
  markdownHref?: string;
  published?: Date;
  tags?: string[];
}

const { title, description, type, noindex, schema, markdownHref, published, tags } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content={SITE_NAME} />
    <meta name="color-scheme" content="dark light" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <Font cssVariable="--astro-font-display" preload={[{ style: "normal" }]} />
    <Font cssVariable="--astro-font-mono" preload={[{ weight: 400 }]} />
    <SeoHead {title} {description} {type} {noindex} {published} {tags} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <link rel="me" href={GITHUB_URL} />
    <script is:inline>
      const applyTheme = () => {
        try {
          const saved = localStorage.getItem("theme");
          document.documentElement.classList.toggle("dark", saved ? saved === "dark" : true);
        } catch {}
      };
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
